#include <iostream>
#include <locale>
#include "windows.h"

using namespace std;

int countMultiplesOfThree(const int* arr, int size) {
    int count = 0;
    for (int i = 0; i < size; i++) {
        if (arr[i] % 3 == 0) {
            count++;
        }
    }
    return count;
}

void fillFilteredArray(const int* src, int srcSize, int* dest) {
    int index = 0;
    for (int i = 0; i < srcSize; i++) {
        if (src[i] % 3 == 0) {
            dest[index] = src[i];
            index++;
        }
    }
}

double calculateAverage(const int* arr, int size) {
    if (size == 0) return 0.0;

    int sum = 0;
    for (int i = 0; i < size; i++) {
        sum += arr[i];
    }
    return (double)sum / size;
}

int main() {
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);

    int n;
    cout << "Введіть розмір початкового масиву: ";
    cin >> n;

    if (n <= 0) {
        cout << "Розмір масиву має бути більшим за 0!" << endl;
        return 1;
    }

    int* arr = new int[n];
    cout << "Введіть " << n << " елементів масиву:" << endl;
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    int count = countMultiplesOfThree(arr, n);

    if (count == 0) {
        cout << "\nЕлементів, кратних 3, не знайдено." << endl;
        delete[] arr;
        return 0;
    }

    int* filteredArr = new int[count];
    fillFilteredArray(arr, n, filteredArr);

    double average = calculateAverage(filteredArr, count);

    cout << "\nНовий масив (елементи, кратні 3): ";
    for (int i = 0; i < count; i++) {
        cout << filteredArr[i] << " ";
    }
    cout << endl;

    cout << "Кількість елементів: " << count << endl;
    cout << "Середнє значення: " << average << endl;

    delete[] arr;
    delete[] filteredArr;

    return 0;
}
