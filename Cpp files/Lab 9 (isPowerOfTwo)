#include <iostream>
#include <windows.h>

using namespace std;

int isPowerOfTwo(int n) {
    if (n == 1) {
		return 0;
    }
	if (n % 2 != 0 || n <= 0) {
        return -1;
    }
	return isPowerOfTwo(n / 2) + 1;
}

int main() {
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);

	int number;

	cout << "Введіть число: ";
	cin >> number;

	int pow = isPowerOfTwo(number);

	if (pow != -1) {
		cout << number << " є степенем двійки, 2^" << pow << " = " << number << endl;
	} else {
		cout << number << " не є степенем двійки" << endl;
	}

    return 0;
}
